generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum SourceType {
  URL
  TEXT
  PROMPT
  FORWARDED_POST
  VIDEO
  AUDIO
  PDF
}

enum PostStatus {
  NEW
  SCHEDULED
  PUBLISHED
  FAILED
  ARCHIVED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum PlanTier {
  STARTER
  CREATOR
  STUDIO_PRO
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id              String  @id @default(cuid())
  email           String? @unique
  name            String?
  telegramId      String? @unique
  activeChannelId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channels       Channel[]
  sourceInputs   SourceInput[]
  generationJobs GenerationJob[]
  subscription   Subscription?
  chatMessages   ChatMessage[]
}

model ChatMessage {
  id      String @id @default(cuid())
  userId  String
  role    String // 'user' | 'assistant'
  content String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Channel {
  id     String  @id @default(cuid())
  name   String
  handle String? @unique
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandKit       BrandKit?
  generatedPosts GeneratedPost[]

  @@index([userId])
}

// ─── BrandKit ─────────────────────────────────────────────────────────────────
// All Channel Style sub-sections are stored as Json blobs, one column per section.
//
// Why Json and not typed columns/enums:
//   - BrandKit is always fetched and written as a whole document per channel.
//   - Individual sub-fields (tone, emoji settings, colors, etc.) are never
//     filtered or indexed independently.
//   - Avoids 10+ Prisma enums that each require a migration on every UX change.
//   - Matches the frontend BrandKit shape directly — no translation layer needed.
//
// Why LinkKit was folded in (no longer a separate table):
//   - The old LinkKit model was a separate table with a single `links Json` column.
//   - That added a required join on every BrandKit fetch with no queryability gain.
//   - It is now `linkKit Json?` here, consistent with every other sub-section.
//

model BrandKit {
  id        String @id @default(cuid())
  channelId String @unique

  // Channel Style v2 sections — shape defined by frontend BrandKit interface
  channelAbout Json? // { topic, targetAudience, contentGoal }
  voiceProfile Json? // { language, addressStyle, authorRole, tone, postLength, examplePosts[], favoriteWords[], forbiddenWords[] }
  linkKit      Json? // { links: LinkItem[] }
  visualKit    Json? // { logoUrl, primaryColor, bannerTemplate, secondaryColor, aspectRatio, textOnCover, logoUsage, references[], avoidList[], ... }
  signature    Json? // { text, cta?, usage }
  postRules    Json? // { defaultStructure, neverCopySource, avoidClickbait, paragraphStyle, listUsage, ctaUsage, thingsToAvoid[], ... }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

model SourceInput {
  id       String     @id @default(cuid())
  userId   String
  type     SourceType
  content  String
  url      String?
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs GenerationJob[]

  @@index([userId])
}

model GenerationJob {
  id            String    @id @default(cuid())
  userId        String
  sourceInputId String
  status        JobStatus @default(PENDING)
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceInput    SourceInput     @relation(fields: [sourceInputId], references: [id], onDelete: Cascade)
  generatedPosts GeneratedPost[]

  @@index([userId])
  @@index([status])
}

model GeneratedPost {
  id              String     @id @default(cuid())
  title           String
  channelId       String
  jobId           String?
  status          PostStatus @default(NEW)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  textRegensUsed  Int        @default(0)
  imageRegensUsed Int        @default(0)

  // Fields present in frontend GeneratedPost type, missing from original scaffold
  sourceType        String? // mirrors SourceType enum values as string for flexibility
  sourceUrl         String?
  sourceSummary     String?
  imagePrompt       String? // original image generation prompt — reused on regenerate-visual
  linkButtons       Json? // LinkItem[]
  selectedVariantId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel  Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  job      GenerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  variants PostVariant[]

  @@index([channelId])
  @@index([status])
  @@index([scheduledAt])
  @@index([jobId])
}

model PostVariant {
  id              String  @id @default(cuid())
  generatedPostId String
  label           String? // matches frontend PostVariant.label
  variantIndex    Int     @default(0)
  text            String
  bannerUrl       String?
  isSelected      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generatedPost GeneratedPost @relation(fields: [generatedPostId], references: [id], onDelete: Cascade)

  @@index([generatedPostId])
}

model PromoCode {
  id           String    @id @default(cuid())
  code         String    @unique               // stored uppercased; matched case-insensitively in app
  tier         PlanTier                          // tier granted on redemption
  durationDays Int                               // days of access the grant lasts
  redeemedAt   DateTime?                          // null = unused; set = burned (single-use)
  redeemedById String?                            // userId that redeemed it
  createdById  String?                            // admin telegramId that created it (audit)

  createdAt DateTime @default(now())

  @@index([code])
}

model Subscription {
  id              String    @id @default(cuid())
  userId          String    @unique
  tier            PlanTier  @default(STARTER)
  aiPostsLimit    Int       @default(30)
  aiPostsUsed     Int       @default(0)
  aiCreatesLimit  Int?                       // null = unlimited (Studio Pro)
  aiCreatesUsed   Int       @default(0)
  quotaResetAt    DateTime?                  // when aiPostsUsed/aiCreatesUsed next reset (monthly)
  expiresAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
