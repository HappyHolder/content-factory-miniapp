generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum SourceType {
  URL
  TEXT
  PROMPT
  FORWARDED_POST
  VIDEO
  AUDIO
  PDF
}

enum PostStatus {
  NEW
  SCHEDULED
  PUBLISHED
  FAILED
  ARCHIVED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum PlanTier {
  FREE
  STARTER
  CREATOR
  STUDIO_PRO
}

// Model strength variant within a plan. LOW = base models (DeepSeek/Flux),
// HIGH = premium models (Claude/GPT Image). Defaults to LOW so existing rows
// keep today's behavior. See docs/low-high-plan.md.
enum ModelTier {
  LOW
  HIGH
}

// Lifecycle of an AI content-manager plan (a whole series of posts).
// DRAFT      = built by the planner, awaiting the user's «Приступить».
// GENERATING = worker is running items sequentially.
// SCHEDULED  = all items processed, posts sit in Отложка.
// FAILED     = worker aborted; CANCELLED = user cancelled.
enum ContentPlanStatus {
  DRAFT
  GENERATING
  SCHEDULED
  FAILED
  CANCELLED
}

// Per-item progress within a ContentPlan. A failed item becomes SKIPPED and the
// plan continues with the next one.
enum PlanItemStatus {
  PENDING
  RESEARCHING
  GENERATING
  DONE
  FAILED
  SKIPPED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id              String  @id @default(cuid())
  email           String? @unique
  name            String?
  telegramId      String? @unique
  activeChannelId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channels       Channel[]
  sourceInputs   SourceInput[]
  generationJobs GenerationJob[]
  subscription   Subscription?
  chatMessages   ChatMessage[]
}

model ChatMessage {
  id      String @id @default(cuid())
  userId  String
  role    String // 'user' | 'assistant'
  content String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Channel {
  id     String  @id @default(cuid())
  name   String
  handle String? @unique
  // Stable numeric Telegram chat id (e.g. "-1001234567890"). Survives channel
  // renames — publishing prefers it over @handle so a rename never breaks it.
  tgChatId String?
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandKit       BrandKit?
  generatedPosts GeneratedPost[]
  projectDocs    ProjectDoc[]
  contentPlans   ContentPlan[]
  community      Community?

  @@index([userId])
}

// ─── BrandKit ─────────────────────────────────────────────────────────────────
// All Channel Style sub-sections are stored as Json blobs, one column per section.
//
// Why Json and not typed columns/enums:
//   - BrandKit is always fetched and written as a whole document per channel.
//   - Individual sub-fields (tone, emoji settings, colors, etc.) are never
//     filtered or indexed independently.
//   - Avoids 10+ Prisma enums that each require a migration on every UX change.
//   - Matches the frontend BrandKit shape directly — no translation layer needed.
//
// Why LinkKit was folded in (no longer a separate table):
//   - The old LinkKit model was a separate table with a single `links Json` column.
//   - That added a required join on every BrandKit fetch with no queryability gain.
//   - It is now `linkKit Json?` here, consistent with every other sub-section.
//

model BrandKit {
  id        String @id @default(cuid())
  channelId String @unique

  // Channel Style v2 sections — shape defined by frontend BrandKit interface
  channelAbout Json? // { topic, targetAudience, contentGoal }
  voiceProfile Json? // { language, addressStyle, authorRole, tone, postLength, examplePosts[], favoriteWords[], forbiddenWords[] }
  linkKit      Json? // { links: LinkItem[] }
  visualKit    Json? // { logoUrl, primaryColor, bannerTemplate, secondaryColor, aspectRatio, textOnCover, logoUsage, references[], avoidList[], ... }
  signature    Json? // { text, cta?, usage }
  postRules    Json? // { defaultStructure, neverCopySource, avoidClickbait, paragraphStyle, listUsage, ctaUsage, thingsToAvoid[], ... }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

model SourceInput {
  id       String     @id @default(cuid())
  userId   String
  type     SourceType
  content  String
  url      String?
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs GenerationJob[]

  @@index([userId])
}

model GenerationJob {
  id            String    @id @default(cuid())
  userId        String
  sourceInputId String
  status        JobStatus @default(PENDING)
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceInput    SourceInput     @relation(fields: [sourceInputId], references: [id], onDelete: Cascade)
  generatedPosts GeneratedPost[]

  @@index([userId])
  @@index([status])
}

model GeneratedPost {
  id              String     @id @default(cuid())
  title           String
  channelId       String
  jobId           String?
  status          PostStatus @default(NEW)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  tgChatId        String?    // chat id of the published channel message — enables edit-in-place
  tgMessageId     Int?       // message id of the published channel message (5-hour re-publish window)
  textRegensUsed  Int        @default(0)
  imageRegensUsed Int        @default(0)

  // Fields present in frontend GeneratedPost type, missing from original scaffold
  sourceType        String? // mirrors SourceType enum values as string for flexibility
  sourceUrl         String?
  sourceSummary     String?
  imagePrompt       String? // original image generation prompt — reused on regenerate-visual
  coverBaseUrl      String? // clean (text-free) cover background — lets the headline be re-rendered without regenerating the picture
  coverMode         String? // actual engine used for this post: ai | html | ai_html
  coverAspectRatio  String? // actual cover ratio used for this post: 1:1 | 16:9 | 4:5 | 9:16
  rubricId          String? // chosen rubric id (from visualKit.rubrics); null = legacy / no rubric
  rubricName        String? // denormalized rubric name — shown on the post chip without a join
  linkButtons       Json? // LinkItem[]
  selectedVariantId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel  Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  job      GenerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  variants PostVariant[]

  @@index([channelId])
  @@index([status])
  @@index([scheduledAt])
  @@index([jobId])
}

model PostVariant {
  id              String  @id @default(cuid())
  generatedPostId String
  label           String? // matches frontend PostVariant.label
  variantIndex    Int     @default(0)
  text            String
  bannerUrl       String?
  isSelected      Boolean @default(false)
  // Structured formatted-post layout (PostBlock[] — see server/src/lib/richPost.ts).
  // null = legacy plain post (publish falls back to text + banner).
  blocks          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generatedPost GeneratedPost @relation(fields: [generatedPostId], references: [id], onDelete: Cascade)

  @@index([generatedPostId])
}

model TonPayment {
  id        String   @id @default(cuid())
  txHash    String   @unique          // TON transaction hash — prevents double-credit
  userId    String
  tier      PlanTier
  amountTon Float
  createdAt DateTime @default(now())

  @@index([userId])
}

model StarsPayment {
  id          String   @id @default(cuid())
  chargeId    String   @unique          // telegram_payment_charge_id — prevents double-credit on duplicate webhook delivery
  userId      String
  tier        PlanTier
  amountStars Int
  createdAt   DateTime @default(now())

  @@index([userId])
}

model PromoCode {
  id           String    @id @default(cuid())
  code         String    @unique               // stored uppercased; matched case-insensitively in app
  tier         PlanTier                          // tier granted on redemption
  modelTier    ModelTier @default(LOW)           // LOW = base models, HIGH = premium models
  durationDays Int                               // days of access the grant lasts
  redeemedAt   DateTime?                          // null = unused; set = burned (single-use)
  redeemedById String?                            // userId that redeemed it
  createdById  String?                            // admin telegramId that created it (audit)

  createdAt DateTime @default(now())

  @@index([code])
}

model Subscription {
  id              String    @id @default(cuid())
  userId          String    @unique
  tier            PlanTier  @default(FREE)
  modelTier       ModelTier @default(LOW)     // LOW = base models, HIGH = premium models
  aiPostsLimit    Int       @default(5)
  aiPostsUsed     Int       @default(0)
  aiCreatesLimit  Int?      @default(5)       // null = unlimited (Studio Pro)
  aiCreatesUsed   Int       @default(0)
  quotaResetAt    DateTime?                  // when aiPostsUsed/aiCreatesUsed next reset (monthly)
  expiresAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Styles market ──────────────────────────────────────────────────────────────
// A Style is a ready-made cover-style PACK curated by us. The user buys (or gets
// for free) a style and "applies" it to a channel — the engine then pours the
// channel's brand + content into the style's templates. One style can bundle
// several HTML templates (e.g. the "Crypto" pack = 9 templates, one per rubric).
//
// Why Json for palette/templates: they mirror the frontend VisualKit shapes
// (BrandColor[], HtmlTemplateItem[]) and are always read/written as a whole —
// no per-field querying needed. Catalog is small, so no indexing concerns.

model Style {
  id   String @id @default(cuid())
  slug String @unique // stable human key, e.g. "crypto", "dither-ascii"

  nameRu String
  nameEn String
  descRu String @default("")
  descEn String @default("")
  tags   String[] @default([])

  // Pricing — FREE styles skip the purchase flow entirely.
  priceKind  String @default("FREE") // "FREE" | "PAID"
  priceStars Int?                     // Telegram Stars (when PAID)
  priceGram  Float?                   // Gram / TON amount (when PAID)

  // Applied into the channel's VisualKit on "Apply".
  brandAdaptive    Boolean @default(true)   // true = pull channel color; false = fixed palette
  recommendedMode  String  @default("html") // "html" | "ai" | "ai_html"
  palette          Json    @default("[]")   // BrandColor[]
  visualCoverStyle String  @default("")      // master AI cover-style text
  bgStyle          String?                   // CoverBgStyle
  bgDetail         String?                   // CoverBgDetail
  fontPreset       String?                   // VisualKit.visualFontPreset
  logoUsage        String?                   // LogoUsage
  templates        Json    @default("[]")   // HtmlTemplateItem[] { name, url }
  carouselTemplate Json?                     // one universal carousel-slide template { name, url, demoSlots } — separate from rubric templates

  // Static demo previews, pre-rendered with a demo brand.
  previews    String[] @default([])
  heroPreview String?

  published Boolean @default(false)
  // Showcase-only: visible in the market to EVERYONE, but only an admin can
  // apply it. Used for the internal Publium / Stepan Logos packs — a shop
  // window so users see what the packs look like without being able to use them.
  showcaseOnly Boolean @default(false)
  sortOrder Int     @default(0)
  createdBy String?                 // admin telegramId that created it (audit)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases StylePurchase[]

  @@index([published, sortOrder])
}

model StylePurchase {
  id        String   @id @default(cuid())
  userId    String
  styleId   String
  via       String // "STARS" | "GRAM" | "FREE" | "ADMIN"
  txHash    String?  @unique // TON tx hash — guards against reusing one deposit for several styles
  createdAt DateTime @default(now())

  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@unique([userId, styleId]) // one ownership row per user/style
  @@index([userId])
}

// ─── AI Content manager ───────────────────────────────────────────────────────
// The content manager lets the assistant generate a whole SERIES of posts and
// drop them into Отложка. A ProjectDoc is uploaded knowledge (whitepaper, deck)
// the planner can base a series on; a ContentPlan is one series; a
// ContentPlanItem is one post-to-be within it. See docs/content-manager-plan.md.

// Uploaded project material attached to a channel's knowledge base. `text` holds
// the extracted plain text (pdf-parse / mammoth), capped ~200k chars; the raw
// file is not stored.
model ProjectDoc {
  id        String   @id @default(cuid())
  channelId String
  name      String
  mime      String
  sizeBytes Int
  text      String
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
}

// One content series. `source` = 'web' | 'uploads' | 'both'. Items are generated
// strictly sequentially by contentWorker; on completion posts sit SCHEDULED.
model ContentPlan {
  id          String            @id @default(cuid())
  channelId   String
  topic       String
  postsPerDay Int
  days        Int
  startDate   DateTime
  source      String            @default("web") // 'web' | 'uploads' | 'both'
  status      ContentPlanStatus @default(DRAFT)
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  items   ContentPlanItem[]

  @@index([channelId])
  @@index([status])
}

// One planned post within a ContentPlan. Carries the pre-chosen rubric so the
// worker skips classification, and links to the GeneratedPost it produced.
model ContentPlanItem {
  id              String         @id @default(cuid())
  planId          String
  orderIndex      Int
  scheduledAt     DateTime
  rubricId        String?
  rubricName      String?
  workingTitle    String
  angle           String
  searchQuery     String
  status          PlanItemStatus @default(PENDING)
  generatedPostId String?
  errorMessage    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan ContentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

// ─── Community & Moderator v1 foundation ────────────────────────────────────
model ModeratorChat {
  id            String     @id @default(cuid())
  tgChatId      String     @unique
  title         String
  username      String?
  type          String
  botStatus     String
  grantedRights Json?
  addedByTgId   String?
  lastUpdateId  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  community     Community?

  @@index([addedByTgId])
}

model Community {
  id              String              @id @default(cuid())
  channelId       String              @unique
  moderatorChatId String?             @unique
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  channel         Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  moderatorChat   ModeratorChat?      @relation(fields: [moderatorChatId], references: [id], onDelete: SetNull)
  moderator       Moderator?
  members         CommunityMember[]
  warnings        ModerationWarning[]
  events          ModerationEvent[]
  scheduledActions ScheduledModerationAction[]
}

model Moderator {
  id                String            @id @default(cuid())
  communityId       String            @unique
  status            String            @default("DRAFT")
  enabled           Boolean           @default(false)
  draftVersion      Int               @default(1)
  publishedVersion  Int?
  requiredRights    Json?
  grantedRights     Json?
  lastRightsCheckAt DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  community         Community         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  configs           ModeratorConfig[]
}

model ModeratorConfig {
  id          String    @id @default(cuid())
  moderatorId String
  version     Int
  status      String    @default("DRAFT")
  blocks      Json
  rules       Json?
  createdById String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  moderator   Moderator @relation(fields: [moderatorId], references: [id], onDelete: Cascade)

  @@unique([moderatorId, version])
  @@index([moderatorId, status])
}

model CommunityMember {
  id              String    @id @default(cuid())
  communityId     String
  tgUserId        String
  status          String    @default("ACTIVE")
  trusted         Boolean   @default(false)
  captchaStatus   String?
  captchaDeadline DateTime?
  joinedAt        DateTime?
  verifiedAt      DateTime?
  joinCount       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  community       Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, tgUserId])
  @@index([communityId, status])
}

model ScheduledModerationAction {
  id                String    @id @default(cuid())
  communityId       String
  actionType         String
  tgChatId           String
  telegramMessageId Int
  executeAt          DateTime
  status             String    @default("PENDING")
  attempts           Int       @default(0)
  lastError          String?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  community          Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([status, executeAt])
  @@unique([tgChatId, telegramMessageId, actionType])
}

model ModerationWarning {
  id          String    @id @default(cuid())
  communityId String
  tgUserId    String
  reason      String
  source      String
  eventId     String?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId, tgUserId, createdAt])
}

model ModerationEvent {
  id                String     @id @default(cuid())
  communityId       String?
  telegramUpdateId  String     @unique
  telegramMessageId Int?
  tgUserId          String?
  blockId           String?
  eventType         String
  decision          String?
  confidence        Float?
  reason            String?
  action            String?
  status            String
  model             String?
  promptVersion     String?
  metadata          Json?
  reversedAt        DateTime?
  reversedById      String?
  createdAt         DateTime   @default(now())
  community         Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)

  @@index([communityId, createdAt])
}
