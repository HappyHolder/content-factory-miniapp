DATABASE_URL=""
DIRECT_URL=""
PORT=8787
NODE_ENV=development
TELEGRAM_BOT_TOKEN=""
# Must match the value set on Render, or the backend rejects webhooks with 401.
TELEGRAM_WEBHOOK_SECRET=""
# Public webhook URL set on Telegram. Used by `npm run set-webhook`.
WEBHOOK_URL="https://content-factory-api.onrender.com/api/bot/webhook"

# Comma-separated Telegram numeric IDs allowed into the admin panel (promo codes)
ADMIN_TELEGRAM_IDS=""

# Optional: Mini App URL for the /start "Open app" button (leave blank to omit)
MINI_APP_URL=""

# TON payments: receiving wallet (public) + TON Center API key (secret)
TON_RECEIVING_WALLET=""
TONCENTER_API_KEY=""

# Web search for the AI assistant (Tavily). Leave blank to disable search.
TAVILY_API_KEY=""

# Vision model on Replicate for reading photos sent to the bot (uses REPLICATE_API_TOKEN).
VISION_MODEL="openai/gpt-4o-mini"

# AI generation (set AI_PROVIDER=deepseek to enable real generation)
AI_PROVIDER="placeholder"
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
