# Publium deploy configuration. Copy to deploy/.env and fill in.
# deploy/.env holds live secrets — it is gitignored, never commit it.

# ── Domain (its DNS A-record must point to this server's IPv4) ──
DOMAIN=publium.ru

# ── PostgreSQL (self-hosted in the db container) ──
POSTGRES_USER=publium
POSTGRES_PASSWORD=CHANGE_ME_to_a_long_random_string
POSTGRES_DB=publium

# ── Telegram (the @Publiumbot token + a random webhook secret) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
MODERATOR_BOT_TOKEN=
MODERATOR_WEBHOOK_SECRET=
MODERATOR_BOT_USERNAME=publium_moder_bot
COMMUNITY_MANAGER_BOT_TOKEN=
COMMUNITY_MANAGER_WEBHOOK_SECRET=
COMMUNITY_MANAGER_BOT_USERNAME=publium_community_bot
# 32+ random characters; keep stable or managed-bot tokens cannot be decrypted
MANAGED_BOT_ENCRYPTION_KEY=
ADMIN_TELEGRAM_IDS=

# ── AI text (DeepSeek) ──
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=

# ── AI images (Replicate) ──
IMAGE_PROVIDER=replicate
REPLICATE_API_TOKEN=
IMAGE_MODEL=black-forest-labs/flux-1.1-pro
COVER_ENGINE=template

# ── Web search (optional; leave blank to disable) ──
TAVILY_API_KEY=

# ── TON payments ──
TON_RECEIVING_WALLET=
TONCENTER_API_KEY=
